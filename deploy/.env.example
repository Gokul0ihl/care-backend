# Copy to .env on the EC2 box (in the same directory as docker-compose.yml).
# Never commit the real .env - it holds real secrets.

# --- Image to run (updated automatically by CI on every deploy) ---
BACKEND_IMAGE=server1.indiahealthlink.com/gokul.saravanan/ihl-hims-backend:latest

# --- Database ---
POSTGRES_USER=postgres
# No @, :, or / characters - this goes inside a URL below.
POSTGRES_PASSWORD=CHANGE-ME-strong-password
POSTGRES_DB=ihl_hims
# wait_for_db.sh connects using these individually (separate from DATABASE_URL
# below) - without them it defaults to a local Unix socket instead of the db
# container and hangs forever waiting. Keep POSTGRES_HOST/PORT set.
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:CHANGE-ME-strong-password@db:5432/ihl_hims

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# --- Django core ---
DJANGO_SETTINGS_MODULE=config.settings.deployment
DJANGO_DEBUG=False
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE-ME
# JSON arrays - fill in the box's Elastic IP (or domain, once you have one)
DJANGO_ALLOWED_HOSTS=["YOUR_ELASTIC_IP"]
# Origins only - scheme + host, no trailing slash. The uploads bucket is not a
# website and must not be listed here.
# localhost entries let a local frontend (dev :4000, preview :4173) use this backend.
CORS_ALLOWED_ORIGINS=["https://hmis-fe.vercel.app","http://ihl-hims-dev-frontend.s3-website.ap-south-1.amazonaws.com","http://localhost:4000","http://localhost:4173"]
CSRF_TRUSTED_ORIGINS=["https://hmis-fe.vercel.app","http://ihl-hims-dev-frontend.s3-website.ap-south-1.amazonaws.com","http://localhost:4000","http://localhost:4173"]

# --- File storage (real S3, not MinIO - leave BUCKET_ENDPOINT/FACILITY_S3_BUCKET_ENDPOINT unset) ---
# AWS_ROLE_BASED makes boto3 use the EC2 instance role. Plain "aws" passes the
# empty key/secret/endpoint below to boto3 and every upload fails with
# "Invalid endpoint".
BUCKET_PROVIDER=AWS_ROLE_BASED
BUCKET_REGION=ap-south-1
FILE_UPLOAD_BUCKET=ihl-hims-dev-uploads
FACILITY_S3_BUCKET=ihl-hims-dev-uploads
# Leave BUCKET_KEY/BUCKET_SECRET unset - the EC2 instance role (set up in
# SETUP_GUIDE.md Part 4) already grants S3 access without needing keys here.
# BUCKET_KEY=
# BUCKET_SECRET=

# --- SMS ---
# False: no SMS is sent and the patient OTP is always 45612.
# True: a random OTP is texted through SMS_BACKEND (FoxxSMS below).
USE_SMS=False
# SMS_BACKEND=care.utils.sms.backend.foxsms.FoxSmsBackend
# FOX_SMS_BASE_URL=http://foxxsms.net/sms//submitsms.jsp
# FOX_SMS_USER=PACONE
# FOX_SMS_SENDER_ID=PACONE
# FOX_SMS_API_KEY=
# Must match the DLT template exactly; \n is a line break.
# OTP_SMS_LOGIN_CONTENT=Welcome to Pacific OneHealth! Your verification code is {otp}. Enter this OTP to complete your registration. Valid for 10 minutes.\nPacific OneHealth

# --- Domains (used in emails / links generated by the backend) ---
CURRENT_DOMAIN=ihl-hims-dev-frontend.s3-website.ap-south-1.amazonaws.com
BACKEND_DOMAIN=YOUR_ELASTIC_IP:9000
