// Registration, Appointment and Health Camp tables
// Generated from the Django models (care + hmis). Regenerate rather than edit by hand.
// created_by_id / updated_by_id point to users_user; those refs are left out to keep the diagram readable.
// Open at https://dbdiagram.io (Import > DBML) or with the VS Code 'DBML Language' extension.

Project care_backend {
  database_type: 'PostgreSQL'
}


Table emr_patient {
  id bigint [pk]
  external_id uuid [unique, not null]
  created_date "timestamp with time zone"
  modified_date "timestamp with time zone"
  deleted boolean [not null]
  history jsonb [not null]
  meta jsonb [not null]
  created_by_id bigint [note: '-> users_user']
  updated_by_id bigint [note: '-> users_user']
  name varchar(200) [not null]
  gender varchar(35) [not null]
  phone_number varchar(14) [not null]
  emergency_phone_number varchar(14) [not null]
  address text [not null]
  permanent_address text [not null]
  pincode integer
  date_of_birth date
  year_of_birth integer
  deceased_datetime "timestamp with time zone"
  blood_group varchar(16) [not null]
  geo_organization_id bigint
  organization_cache "integer[]" [not null]
  users_cache "integer[]" [not null]
  instance_identifiers jsonb
  facility_identifiers jsonb
  instance_tags "integer[]" [not null]
  facility_tags jsonb
  extensions jsonb [not null]
  registration_facility_id bigint
  registered_at "timestamp with time zone"
  registered_by_id bigint
  registration_type varchar(10) [not null]
  title varchar(10) [not null]
  first_name varchar(40) [not null]
  middle_name varchar(40) [not null]
  last_name varchar(40) [not null]
  marital_status varchar(20) [not null]
  father_name varchar(100) [not null]
  mother_name varchar(100) [not null]
  guardian_name varchar(40) [not null]
  guardian_relationship varchar(10) [not null]
  occupation varchar(50) [not null]
  religion varchar(30) [not null]
  preferred_language varchar(30) [not null]
  mobile_owner varchar(20) [not null]
  whatsapp_number varchar(16) [not null]
  whatsapp_owner varchar(20) [not null]
  alternate_phone_number varchar(16) [not null]
  alternate_phone_owner varchar(20) [not null]
  email varchar(254) [not null]
  house varchar(100) [not null]
  street varchar(150) [not null]
  locality varchar(100) [not null]
  city varchar(100) [not null]
  district varchar(100) [not null]
  state varchar(100) [not null]
  permanent_house varchar(100) [not null]
  permanent_street varchar(150) [not null]
  permanent_locality varchar(100) [not null]
  permanent_city varchar(100) [not null]
  permanent_district varchar(100) [not null]
  permanent_state varchar(100) [not null]
  permanent_pincode varchar(12) [not null]
  permanent_country varchar(60) [not null]
  next_of_kin_title varchar(10) [not null]
  next_of_kin_name varchar(40) [not null]
  next_of_kin_relationship varchar(30) [not null]
  next_of_kin_phone varchar(16) [not null]
  nationality_category varchar(20) [not null]
  identity_storage_consent boolean [not null]
  identity_card_type varchar(20) [not null]
  identity_number_last4 varchar(4) [not null]
  capture_id_method varchar(12) [not null]
  abha_status varchar(10) [not null]
  abha_number varchar(14) [not null]
  abha_address varchar(60) [not null]
  nationality varchar(60) [not null]
  passport_number varchar(15) [not null]
  passport_expiry date
  visa_type varchar(30) [not null]
  visa_expiry date
  frro_c_form varchar(50) [not null]
  address_in_india varchar(300) [not null]
  interpreter_language varchar(30) [not null]
  allergy_status varchar(10) [not null]
  assistance_needs "varchar(30)[]" [not null]
  pregnancy_status varchar(20) [not null]
  is_vip boolean [not null]
  vip_note varchar(200) [not null]
  vip_authorised_by varchar(100) [not null]
  handle_with_care boolean [not null]
  vip_flagged_by_id bigint
  payer_type varchar(20) [not null]
  payer_name varchar(200) [not null]
  staff_category varchar(20) [not null]
  employee_id varchar(24) [not null]
  policy_number varchar(24) [not null]
  policy_valid_till date
  policy_holder_relationship varchar(30) [not null]
  concessions jsonb [not null]
  concession varchar(60) [not null]
  concession_approved_by varchar(100) [not null]
  arrival_source varchar(40) [not null]
  lead_source varchar(60) [not null]
  camp_name varchar(100) [not null]
  camp_patient_id varchar(30) [not null]
  referring_provider varchar(200) [not null]
  referrer_registration_number varchar(30) [not null]
  referrer_organisation varchar(200) [not null]
  remarks text [not null]
  consent_given_by varchar(20) [not null]
  consent_method varchar(20) [not null]
  consent_witness varchar(40) [not null]
  consent_language varchar(30) [not null]
  general_consent boolean [not null]
  data_processing_consent boolean [not null]
  tariff_consent boolean [not null]
  international_tariff_consent boolean [not null]
  share_with_referrer_consent boolean [not null]
  abdm_link_consent boolean [not null]
  teleconsultation_consent boolean [not null]
  clinical_photography_consent boolean [not null]
  research_consent boolean [not null]
  communication_channels "varchar(20)[]" [not null]
  do_not_contact boolean [not null]
  promotions_consent boolean [not null]
  promotion_purposes "varchar(30)[]" [not null]
  quick_registered_at "timestamp with time zone"
  quick_registered_by_id bigint
  quick_facility_id bigint
  quick_consultation_type varchar(20) [not null]
  quick_department_id bigint
  quick_doctor_id bigint
  quick_whatsapp_same_as_mobile boolean [not null]
  quick_send_form_link boolean [not null]
  quick_send_payment_reminder boolean [not null]
  quick_form_token varchar(64) [unique]
  quick_form_expires_at "timestamp with time zone"
  quick_form_link_sent_at "timestamp with time zone"
  quick_form_submitted_at "timestamp with time zone"
  quick_form_details jsonb [not null]
  restricted_alias varchar(9) [unique]
  restricted_at "timestamp with time zone"
  birth_mother_id bigint
  birth_facility_id bigint
  born_at "timestamp with time zone"
  birth_order smallint
  number_of_babies smallint
  delivery_type varchar(30) [not null]
  gestation_weeks smallint
  birth_weight_grams smallint
  length_cm numeric(4, 1)
  head_circumference_cm numeric(4, 1)
  apgar_1_min smallint
  apgar_5_min smallint
  Note: 'emr.Patient'
}

Table emr_patientidentifier {
  id bigint [pk]
  external_id uuid [unique, not null]
  created_date "timestamp with time zone"
  modified_date "timestamp with time zone"
  deleted boolean [not null]
  history jsonb [not null]
  meta jsonb [not null]
  created_by_id bigint [note: '-> users_user']
  updated_by_id bigint [note: '-> users_user']
  facility_id bigint
  patient_id bigint [not null]
  config_id bigint [not null]
  value varchar(1024) [not null]
  Note: 'emr.PatientIdentifier'
}

