  title varchar(8) [not null]
  first_name varchar(40) [not null]
  middle_name varchar(40) [not null]
  last_name varchar(40) [not null]
  gender varchar(10) [not null]
  date_of_birth date [not null]
  preferred_language varchar(40) [not null]
  nationality varchar(20) [not null]
  blood_group varchar(8) [not null]
  photo_id bigint
  mobile_isd varchar(5) [not null]
  mobile varchar(12) [not null]
  mobile_belongs_to varchar(10) [not null]
  whatsapp varchar(12) [not null]
  alt_mobile_isd varchar(5) [not null]
  alt_mobile varchar(12) [not null]
  alt_mobile_belongs_to varchar(20) [not null]
  address varchar(200) [not null]
  country varchar(60) [not null]
  state varchar(100) [not null]
  city varchar(100) [not null]
  district varchar(100) [not null]
  pincode varchar(6) [not null]
  area varchar(80) [not null]
  permanent_same_as_current boolean [not null]
  permanent_address jsonb [not null]
  id_type varchar(20) [not null]
  id_number varchar(30) [not null]
  allergy_status varchar(8) [not null]
  allergen varchar(60) [not null]
  allergy_reaction varchar(60) [not null]
  allergy_severity varchar(20) [not null]
  bp varchar(7) [not null]
  rbs_mg_dl smallint
  height_cm numeric(4, 1)
  weight_kg numeric(5, 1)
  bmi numeric(4, 1)
  finding text [not null]
  refer_to_department varchar(80) [not null]
  consent_screening boolean [not null]
  consent_dpdp_notice boolean [not null]
  consent_tariff boolean [not null]
  consent_by varchar(30) [not null]
  consent_channel varchar(30) [not null]
  consent_witness varchar(40) [not null]
  consent_file_id bigint
  send_via jsonb [not null]
  extra_answers jsonb [not null]
  form_version integer [not null]
  status varchar(12) [not null]
  verification_code varchar(8) [not null]
