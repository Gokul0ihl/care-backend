Table hmis_outreachevent {
  id bigint [pk]
  external_id uuid [unique, not null]
  created_date "timestamp with time zone"
  modified_date "timestamp with time zone"
  deleted boolean [not null]
  history jsonb [not null]
  meta jsonb [not null]
  created_by_id bigint [note: '-> users_user']
  updated_by_id bigint [note: '-> users_user']
  number varchar(24) [unique]
  event_type varchar(4) [not null]
  facility_id bigint [not null]
  name varchar(120) [not null]
  theme varchar(120) [not null]
  description text [not null]
  venue_name varchar(120) [not null]
  address varchar(255) [not null]
  pincode varchar(6) [not null]
  platform varchar(40) [not null]
  join_link varchar(500) [not null]
  event_date date [not null]
  start_time time
  end_time time
  expected_attendees integer
  has_coupon boolean [not null]
  coupon_code varchar(12) [not null]
  coupon_valid_from date
  coupon_valid_to date
  discount_registration_pct smallint
  discount_consultation_pct smallint
  discount_tests_pct smallint
  report_delivery varchar(20) [not null]
  permission_needed boolean [not null]
  permission_from varchar(120) [not null]
  permission_cost numeric(10, 2)
  cme_audience varchar(120) [not null]
  cme_accreditation_body varchar(60) [not null]
  cme_credit_hours numeric(4, 1)
  status varchar(20) [not null]
  version integer [not null]
  submitted_at "timestamp with time zone"
  submitted_by_id bigint
  decided_at "timestamp with time zone"
  decided_by_id bigint
  decision_remarks text [not null]
  Note: 'hmis.OutreachEvent'
}

