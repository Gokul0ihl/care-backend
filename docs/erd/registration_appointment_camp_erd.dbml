Table hmis_outreacheventtest {
  id bigint [pk]
  event_id bigint [not null]
  external_id uuid [unique, not null]
  name varchar(120) [not null]
  lab_test_id bigint
  location varchar(10) [not null]
  fee_type varchar(4) [not null]
