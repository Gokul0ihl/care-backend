// CARE / POH backend - all tables
// Generated from the Django models (care + hmis). Regenerate rather than edit by hand.
// created_by_id / updated_by_id point to users_user; those refs are left out to keep the diagram readable.
// Open at https://dbdiagram.io (Import > DBML) or with the VS Code 'DBML Language' extension.

Project care_backend {
  database_type: 'PostgreSQL'
}


Table auth_group {
  id integer [pk]
  name varchar(150) [unique, not null]
  Note: 'auth.Group'
}

Table auth_group_permissions {
  id integer [pk]
  group_id integer [not null]
  permission_id integer [not null]
  Note: 'auth.Group_permissions'
}

Table auth_permission {
  id integer [pk]
  name varchar(255) [not null]
  content_type_id integer [not null]
  codename varchar(100) [not null]
  Note: 'auth.Permission'
}

Table authtoken_token {
  key varchar(40) [pk]
  user_id bigint [unique, not null]
  created "timestamp with time zone" [not null]
  Note: 'authtoken.Token'
}

Table django_admin_log {
  id integer [pk]
  action_time "timestamp with time zone" [not null]
  user_id bigint [not null]
  content_type_id integer
  object_id text
  object_repr varchar(200) [not null]
  action_flag smallint [not null]
  change_message text [not null]
  Note: 'admin.LogEntry'
}

Table django_content_type {
  id integer [pk]
  app_label varchar(100) [not null]
  model varchar(100) [not null]
  Note: 'contenttypes.ContentType'
}

Table django_session {
  session_key varchar(40) [pk]
  session_data text [not null]
  expire_date "timestamp with time zone" [not null]
  Note: 'sessions.Session'
}

Table django_site {
  id integer [pk]
  domain varchar(100) [unique, not null]
  name varchar(50) [not null]
  Note: 'sites.Site'
}

Table emr_account {
  id bigint [pk]
  external_id uuid [unique, not null]
  created_date "timestamp with time zone"
  modified_date "timestamp with time zone"
  deleted boolean [not null]
  history jsonb [not null]
  meta jsonb [not null]
  created_by_id bigint [note: '-> users_user']
  updated_by_id bigint [note: '-> users_user']
  facility_id bigint [not null]
  status varchar(255) [not null]
  billing_status varchar(255) [not null]
  name varchar(255) [not null]
  service_period jsonb [not null]
  description text
  patient_id bigint [not null]
  cached_items jsonb [not null]
  total_net numeric(20, 6) [not null]
  total_gross numeric(20, 6) [not null]
  total_paid numeric(20, 6) [not null]
  total_balance numeric(20, 6) [not null]
  total_price_components jsonb [not null]
  calculated_at "timestamp with time zone"
  total_billable_charge_items numeric(20, 6) [not null]
  tags "integer[]" [not null]
  extensions jsonb [not null]
  primary_encounter_id bigint
  Note: 'emr.Account'
}

Table emr_activitydefinition {
  id bigint [pk]
  external_id uuid [unique, not null]
  created_date "timestamp with time zone"
  modified_date "timestamp with time zone"
  deleted boolean [not null]
  history jsonb [not null]
  meta jsonb [not null]
  created_by_id bigint [note: '-> users_user']
  updated_by_id bigint [note: '-> users_user']
  facility_id bigint [not null]
  version integer [not null]
  slug varchar(255) [not null]
  title varchar(1024) [not null]
  classification varchar(100) [not null]
  derived_from_uri text
  status varchar(255) [not null]
  description text [not null]
  usage text [not null]
  kind varchar(100) [not null]
  code jsonb
  body_site jsonb
  specimen_requirements "integer[]" [not null]
  observation_result_requirements "integer[]" [not null]
  locations "integer[]" [not null]
  latest boolean [not null]
  charge_item_definitions "integer[]" [not null]
  diagnostic_report_codes jsonb
  healthcare_service_id bigint
  tags "integer[]" [not null]
  category_id bigint
  Note: 'emr.ActivityDefinition'
}

Table emr_allergyintolerance {
  id bigint [pk]
  external_id uuid [unique, not null]
  created_date "timestamp with time zone"
  modified_date "timestamp with time zone"
  deleted boolean [not null]
  history jsonb [not null]
  meta jsonb [not null]
  created_by_id bigint [note: '-> users_user']
  updated_by_id bigint [note: '-> users_user']
  clinical_status varchar(100)
  verification_status varchar(100)
  category varchar(100)
  criticality varchar(100)
  code jsonb [not null]
  patient_id bigint [not null]
  encounter_id bigint [not null]
  onset jsonb [not null]
  recorded_date "timestamp with time zone"
  last_occurrence "timestamp with time zone"
  note text
  copied_from bigint
  allergy_intolerance_type varchar(20) [not null]
  Note: 'emr.AllergyIntolerance'
}

Table emr_appointmentsequence {
  id bigint [pk]
  year integer [unique, not null]
  last_value integer [not null]
  Note: 'emr.AppointmentSequence'
}

Table emr_availability {
  id bigint [pk]
  external_id uuid [unique, not null]
  created_date "timestamp with time zone"
  modified_date "timestamp with time zone"
  deleted boolean [not null]
  history jsonb [not null]
  meta jsonb [not null]
  created_by_id bigint [note: '-> users_user']
  updated_by_id bigint [note: '-> users_user']
  schedule_id bigint [not null]
  name varchar(255) [not null]
  slot_type varchar [not null]
  slot_size_in_minutes integer
  tokens_per_slot integer
  create_tokens boolean [not null]
  reason text
  availability jsonb [not null]
  walk_in_every smallint
  Note: 'emr.Availability'
}

Table emr_availabilityexception {
  id bigint [pk]
  external_id uuid [unique, not null]
  created_date "timestamp with time zone"
  modified_date "timestamp with time zone"
  deleted boolean [not null]
  history jsonb [not null]
  meta jsonb [not null]
  created_by_id bigint [note: '-> users_user']
  updated_by_id bigint [note: '-> users_user']
  resource_id bigint [not null]
  name varchar(255) [not null]
  reason text
  valid_from date [not null]
  valid_to date [not null]
  start_time time [not null]
  end_time time [not null]
  Note: 'emr.AvailabilityException'
}

Table emr_chargeitem {
  id bigint [pk]
  external_id uuid [unique, not null]
  created_date "timestamp with time zone"
  modified_date "timestamp with time zone"
