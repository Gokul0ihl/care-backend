  name varchar(80) [not null]
  fields jsonb [not null]
  Note: 'hmis.OutreachFormTemplate'
}

Table hmis_patientaccount {
  id bigint [pk]
  patient_id bigint [unique, not null]
  password varchar(128) [not null]
  created_at "timestamp with time zone" [not null]
  Note: 'hmis.PatientAccount'
}

Table hmis_patientdocument {
  id bigint [pk]
  external_id uuid [unique, not null]
  created_date "timestamp with time zone"
  modified_date "timestamp with time zone"
  deleted boolean [not null]
  history jsonb [not null]
  meta jsonb [not null]
  created_by_id bigint [note: '-> users_user']
  updated_by_id bigint [note: '-> users_user']
  file_id bigint [unique, not null]
  patient_id bigint
  category varchar(30) [not null]
  side varchar(10) [not null]
  capture_method varchar(20) [not null]
  source varchar(100) [not null]
  document_date date
  Note: 'hmis.PatientDocument'
}

Table hmis_patientmerge {
  id bigint [pk]
  external_id uuid [unique, not null]
  created_date "timestamp with time zone"
  modified_date "timestamp with time zone"
  deleted boolean [not null]
  history jsonb [not null]
  meta jsonb [not null]
  created_by_id bigint [note: '-> users_user']
  updated_by_id bigint [note: '-> users_user']
  source_id bigint [not null]
  target_id bigint [not null]
  reason varchar(500) [not null]
  choices jsonb [not null]
  source_snapshot jsonb [not null]
  moved jsonb [not null]
  consent_document_id bigint
  Note: 'hmis.PatientMerge'
}

Table hmis_patientnumbersequence {
  id bigint [pk]
  series varchar(4) [not null]
  facility_id bigint [not null]
  period varchar(8) [not null]
  last_value integer [not null]
  Note: 'hmis.PatientNumberSequence'
}

Table hmis_patientsession {
  id bigint [pk]
  account_id bigint [not null]
  phone_number varchar(16) [not null]
  refresh_jti varchar(64) [not null]
  previous_refresh_jti varchar(64) [not null]
  rotated_at "timestamp with time zone"
  fcm_token varchar(512) [not null]
  created_at "timestamp with time zone" [not null]
  last_used_at "timestamp with time zone"
  revoked_at "timestamp with time zone"
  Note: 'hmis.PatientSession'
}

Table hmis_postoffice {
  id bigint [pk]
  pincode varchar(6) [not null]
  name varchar(100) [not null]
  office_type varchar(10) [not null]
  delivery boolean [not null]
  district varchar(100) [not null]
  state varchar(100) [not null]
  loaded_at "timestamp with time zone" [not null]
  Note: 'hmis.PostOffice'
}

Table hmis_registrationallergy {
  id bigint [pk]
  patient_id bigint [not null]
  substance varchar(100) [not null]
  reaction varchar(100) [not null]
  severity varchar(20) [not null]
  Note: 'hmis.RegistrationAllergy'
}

Table hmis_statutoryflag {
  id bigint [pk]
