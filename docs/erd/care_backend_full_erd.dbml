  name varchar(255) [unique, not null]
  description text
  Note: 'users.Skill'
}

Table users_user {
  id bigint [pk]
  password varchar(128) [not null]
  last_login "timestamp with time zone"
  is_superuser boolean [not null]
  first_name varchar(150) [not null]
  last_name varchar(150) [not null]
  email varchar(254) [not null]
  is_staff boolean [not null]
  is_active boolean [not null]
  date_joined "timestamp with time zone" [not null]
  external_id uuid [unique, not null]
  username varchar(150) [unique, not null]
  user_type varchar(100)
  created_by_id bigint [note: '-> users_user']
  geo_organization_id bigint
  phone_number varchar(14) [not null]
  alt_phone_number varchar(14)
  video_connect_link varchar(200)
  old_gender integer
  gender varchar(100)
  date_of_birth date
  profile_picture_url varchar(500)
  home_facility_id bigint
  weekly_working_hours integer
  qualification text
  doctor_experience_commenced_on date
  doctor_medical_council_registration varchar(255)
  prefix varchar(10)
  suffix varchar(50)
  is_service_account boolean [not null]
  verified boolean [not null]
  deleted boolean [not null]
  pf_endpoint text
  pf_p256dh text
  pf_auth text
  totp_secret text
  mfa_settings jsonb [not null]
  preferences jsonb [not null]
  cached_role_orgs jsonb
  Note: 'users.User'
}

Table users_user_groups {
